{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CAEAgentEvaluationResult",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "benchmark_version": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "properties": {
        "os": { "type": "string" },
        "python_version": { "type": "string" },
        "codex_cli_version": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "git_commit": { "type": ["string", "null"] }
      },
      "required": ["os", "python_version"]
    },
    "status": {
      "type": "string",
      "enum": ["COMPLETED", "AGENT_EVAL_SKIPPED", "PARTIAL", "FAILED"]
    },
    "skip_reason": {
      "type": ["string", "null"]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string" },
          "title": { "type": "string" },
          "vanilla": {
            "type": "object",
            "properties": {
              "status": { "type": "string" },
              "exit_code": { "type": ["integer", "null"] },
              "passed": { "type": "boolean" },
              "test_pass_rate": { "type": "number" },
              "execution_time_seconds": { "type": "number" },
              "timed_out": { "type": "boolean" },
              "tool_calls": { "type": "integer" },
              "changed_files": { "type": "array", "items": { "type": "string" } },
              "patch_correctness": { "type": "string" },
              "log_path": { "type": "string" }
            },
            "required": ["passed", "test_pass_rate", "execution_time_seconds"]
          },
          "cae": {
            "type": "object",
            "properties": {
              "status": { "type": "string" },
              "exit_code": { "type": ["integer", "null"] },
              "passed": { "type": "boolean" },
              "test_pass_rate": { "type": "number" },
              "execution_time_seconds": { "type": "number" },
              "timed_out": { "type": "boolean" },
              "tool_calls": { "type": "integer" },
              "changed_files": { "type": "array", "items": { "type": "string" } },
              "patch_correctness": { "type": "string" },
              "log_path": { "type": "string" }
            },
            "required": ["passed", "test_pass_rate", "execution_time_seconds"]
          }
        },
        "required": ["task_id", "title", "vanilla", "cae"]
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_tasks": { "type": "integer" },
        "vanilla_passed": { "type": "integer" },
        "vanilla_pass_rate": { "type": "number" },
        "cae_passed": { "type": "integer" },
        "cae_pass_rate": { "type": "number" },
        "iterations": { "type": "integer" }
      },
      "required": ["total_tasks", "vanilla_passed", "vanilla_pass_rate", "cae_passed", "cae_pass_rate"]
    }
  },
  "required": [
    "run_id",
    "timestamp",
    "benchmark_version",
    "environment",
    "status",
    "tasks",
    "summary"
  ]
}
